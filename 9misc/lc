#!/usr/bin/env bash

# Plan 9's compact, column-oriented directory listing.
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
columnator=mc
if [[ -x $script_dir/mc ]]; then
    columnator=$script_dir/mc
fi

# Piped ls output is one entry per line; mc handles the active window layout.
# shellcheck disable=SC2012 # lc intentionally formats ls output with mc.
ls -1 "$@" | "$columnator"
